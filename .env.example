# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WinyPay Bangladesh Merchant Integration Credentials
WINYPAY_BASE_URL="https://winypay.com"
WINYPAY_MERCHANT_CODE="M1001"
WINYPAY_SECRET_KEY="abc123"
WINYPAY_PAYOUT_KEY="abc123"
WINYPAY_PAYIN_ENDPOINT="/api/v1/test/payin.php"
WINYPAY_PAYOUT_ENDPOINT="/api/v1/test/payout.php"
WINYPAY_CALLBACK_URL="https://YOUR_DOMAIN/api/v1/callback/payin"

# cPanel Backend API & Deposit URL
CPANEL_API_BASE_URL="https://api.nvtenergy.online"
CPANEL_DEPOSIT_URL="https://api.nvtenergy.online/deposit"

# Real Email OTP Delivery (Gmail or SMTP Gateway)
# Option A: Gmail with App Password (Recommended)
# 1. Enable 2-Step Verification in Google Account (myaccount.google.com/security)
# 2. Go to "App passwords" -> Create password for "NVT Mail"
# 3. Enter the 16-character password below:
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Option B: Standard SMTP Gateway (SendGrid / Mailgun / Brevo / cPanel Webmail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="NVT Energy <no-reply@nvtenergy.com>"

